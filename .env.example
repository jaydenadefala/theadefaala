# Copy this file to .env.local (development) and fill in real values.
# Never commit .env.local, .env, or any file with real secrets.

# Required. Payload uses this to sign auth cookies/sessions — must be a
# long, random string in production, never reused across environments.
PAYLOAD_SECRET=

# Required. Local dev: a SQLite file path, e.g. file:./payload.db
# Production: a PostgreSQL connection string, e.g.
# postgres://user:password@host:5432/dbname
# (switching the value alone doesn't switch drivers — see README's
# "Production database" section)
DATABASE_URL=file:./payload.db

# Optional. Public site origin, used for sitemap/robots/canonical URLs
# and Open Graph absolute image URLs. Falls back to
# http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional, local dev only. Set to "true" for exactly one run after
# editing a Payload collection/global's fields, to push the schema
# change to your local SQLite database (see README). Never set this
# in production.
PAYLOAD_PUSH_SCHEMA=false
